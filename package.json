{
  "name": "pinflow",
  "version": "0.0.0",
  "description": "Figma-style pin-and-comment annotation for vibe-coded prototypes. Zero backend, one-line install, AI-agent-ready markdown export.",
  "keywords": [
    "annotation",
    "feedback",
    "comments",
    "prototype",
    "review",
    "pin",
    "markdown",
    "claude",
    "cursor",
    "vibe-coding"
  ],
  "license": "MIT",
  "homepage": "https://pinflow.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinflow/pinflow.git"
  },
  "bugs": {
    "url": "https://github.com/pinflow/pinflow/issues"
  },
  "author": "Pinflow contributors",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/pinflow.iife.js",
  "jsdelivr": "./dist/pinflow.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build && pnpm test && pnpm size"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "^1.49.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^2.1.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "vue": "^3.5.12"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "size-limit": [
    {
      "name": "core (IIFE, gz)",
      "path": "dist/pinflow.iife.js",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "name": "core (ESM, gz)",
      "path": "dist/index.js",
      "limit": "30 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
